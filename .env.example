# ──────────────────────────────────────────────────────────────────────────
#  J.A.R.V.I.S. — environment configuration
#  Copy this file to `.env` and fill in your values.
# ──────────────────────────────────────────────────────────────────────────

# DeepSeek API key (https://platform.deepseek.com/).  Without it, the AI
# console runs in OFFLINE mode and returns canned diagnostics instead of
# live model output.
DEEPSEEK_API_KEY=

# DeepSeek endpoint + model (defaults are fine for most users).
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Windy Webcams API key (https://api.windy.com/webcams) — OPTIONAL. Unlocks the
# live, worldwide public-webcam directory on the Orbital Globe. Without it, a
# curated public-webcam sample is shown. You can also paste both keys at runtime
# in the terminal's ⚙ SETTINGS panel instead of using this file.
WINDY_WEBCAMS_API_KEY=

# Flask server bind address / port.
JARVIS_HOST=0.0.0.0
JARVIS_PORT=8765

# Seconds to cache external feeds (news / surveillance) before refetching.
JARVIS_CACHE_TTL=180
