# ──────────────────────────────────────────────────────────────────────────
#  J.A.R.V.I.S. — environment configuration
#  Copy this file to `.env` and fill in your values.
# ──────────────────────────────────────────────────────────────────────────

# DeepSeek API key (https://platform.deepseek.com/).  Without it, the AI
# console runs in OFFLINE mode and returns canned diagnostics instead of
# live model output.
DEEPSEEK_API_KEY=

# DeepSeek endpoint + model (defaults are fine for most users).
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Note: ALL data feeds (news, surveillance, satellite, markets, public webcams)
# are free and KEYLESS. The only key you might set is DeepSeek above (for the AI
# core), and you can paste that at runtime in the ⚙ SETTINGS panel instead.

# ── DEV agent (self-coding) — OPTIONAL, off by default ─────────────────────
# It modifies project files, so it only runs when explicitly enabled:
#   JARVIS_ENABLE_DEVAGENT=1
# By default it can only edit the Jarvis repo. To let it work on OTHER folders
# on your device (e.g. your own projects), grant specific directories — comma or
# colon separated absolute paths. Grant only what you need; never set this to
# your whole device. '/' is refused; .git and secret files are always blocked.
#   JARVIS_DEV_ROOTS=/storage/emulated/0/Projects/foo,/storage/emulated/0/Projects/bar

# Flask server bind address / port.
JARVIS_HOST=0.0.0.0
JARVIS_PORT=8765

# Seconds to cache external feeds (news / surveillance) before refetching.
JARVIS_CACHE_TTL=180
