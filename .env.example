# ──────────────────────────────────────────────────────────────────────────
#  J.A.R.V.I.S. — environment configuration
#  Copy this file to `.env` and fill in your values.
# ──────────────────────────────────────────────────────────────────────────

# DeepSeek API key (https://platform.deepseek.com/).  Without it, the AI
# console runs in OFFLINE mode and returns canned diagnostics instead of
# live model output.
DEEPSEEK_API_KEY=

# DeepSeek endpoint + model (defaults are fine for most users).
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Note: ALL data feeds (news, surveillance, satellite, markets, public webcams)
# are free and KEYLESS. The only key you might set is DeepSeek above (for the AI
# core), and you can paste that at runtime in the ⚙ SETTINGS panel instead.

# Flask server bind address / port.
JARVIS_HOST=0.0.0.0
JARVIS_PORT=8765

# Seconds to cache external feeds (news / surveillance) before refetching.
JARVIS_CACHE_TTL=180
