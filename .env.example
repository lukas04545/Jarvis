# ──────────────────────────────────────────────────────────────────────────
#  J.A.R.V.I.S. — environment configuration
#  Copy this file to `.env` and fill in at least ONE free LLM provider key.
#  All providers are free-tier. Source: https://github.com/cheahjs/free-llm-api-resources
# ──────────────────────────────────────────────────────────────────────────

# ── FREE LLM PROVIDERS (configure one or more; JARVIS auto-selects) ────────

# 1. Google AI Studio — Gemini 2.0 Flash — 250K tokens/min FREE
#    Get key: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
# GOOGLE_MODEL=gemini-2.0-flash

# 2. Groq — Llama 3.3 70B — 14.4K requests/day FREE (extremely fast)
#    Get key: https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# 3. Cerebras — Llama 3.1 70B — 1M tokens/day FREE (very fast)
#    Get key: https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# CEREBRAS_MODEL=llama3.1-70b

# 4. OpenRouter — Llama 3.3 70B (free tier) — 50 requests/day FREE
#    Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# 5. Mistral AI — Mistral Small — 1B tokens/month FREE (phone verification)
#    Get key: https://console.mistral.ai
MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest

# 6. Cohere — Command A — 1K requests/month FREE
#    Get key: https://cohere.com/
COHERE_API_KEY=
# COHERE_MODEL=command-a-03-2025

# 7. HuggingFace — Llama 3.3 70B — $0.10/month free credits
#    Get key: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=
# HUGGINGFACE_MODEL=meta-llama/Llama-3.3-70B-Instruct

# 8. DeepSeek — deepseek-chat — paid / trial credits
#    Get key: https://platform.deepseek.com
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat

# ── PROVIDER PRIORITY (optional, default shown) ────────────────────────────
# Comma-separated list of provider IDs in fallback order:
# LLM_PROVIDER_ORDER=google,groq,cerebras,openrouter,mistral,cohere,huggingface,deepseek

# ── DEV AGENT (self-coding) — OPTIONAL, off by default ─────────────────────
# JARVIS_ENABLE_DEVAGENT=1
# JARVIS_DEV_ROOTS=/path/to/your/project

# ── SERVER ─────────────────────────────────────────────────────────────────
JARVIS_HOST=0.0.0.0
JARVIS_PORT=8765
JARVIS_CACHE_TTL=180

# ── OTHER KEYS ─────────────────────────────────────────────────────────────
# Have I Been Pwned — optional, enables live breach lookups in RECON desk
# Get key: https://haveibeenpwned.com/API/Key
HIBP_API_KEY=
